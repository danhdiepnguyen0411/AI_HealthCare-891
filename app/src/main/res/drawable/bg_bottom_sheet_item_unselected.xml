<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#120F67FE">
    <!-- Mask to clip ripple strictly to 18dp rounded corners -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Transparent outer spacer matching 18dp radius of selected card halo ring -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Crisp White Card Surface inset by 3dp to align with selected card -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <selector>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#F4F7FF" />
                    <stroke
                        android:width="1dp"
                        android:color="#4E75F7" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="@color/white" />
                    <stroke
                        android:width="1dp"
                        android:color="#E6ECF5" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
