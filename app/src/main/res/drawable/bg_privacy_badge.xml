<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow (Figma: X:0, Y:2, Blur:4, #000000 6%) -->
    <item
        android:bottom="0dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#0F000000" />
        </shape>
    </item>
    <!-- Crisp Surface: Secondary color btn (#D6E8FF) -->
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/secondary_color_btn" />
        </shape>
    </item>
</layer-list>
