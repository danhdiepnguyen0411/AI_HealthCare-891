<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft outer drop shadow (Figma: X:0, Y:2, Blur:4, #000000 6%) -->
    <item
        android:bottom="0dp"
        android:left="1dp"
        android:right="1dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#0F000000" />
        </shape>
    </item>
    <!-- Selected Card Surface: #CFE1FF with 1.5dp #306BFF Stroke -->
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#CFE1FF" />
            <stroke
                android:width="1.5dp"
                android:color="#306BFF" />
        </shape>
    </item>
</layer-list>
