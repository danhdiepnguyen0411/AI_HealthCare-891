<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow (Figma: X:0, Y:2, Blur:6, #000000 6%) -->
    <item
        android:bottom="0dp"
        android:left="1dp"
        android:right="1dp"
        android:top="2.5dp">
        <shape android:shape="oval">
            <solid android:color="#0F000000" />
        </shape>
    </item>
    <!-- Crisp White Circular Button Surface -->
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>
