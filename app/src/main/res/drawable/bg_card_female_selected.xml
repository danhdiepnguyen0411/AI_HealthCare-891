<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 4dp Outer Spread Ring: #40FA4D5E with 24dp radius -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/gender_female_ring" />
        </shape>
    </item>
    <!-- Inner Solid Card: radius 20dp, #FE808B -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/gender_female_bg" />
        </shape>
    </item>
</layer-list>
