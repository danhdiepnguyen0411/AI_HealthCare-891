<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 4dp Outer Ring: #0F67FE with 25% opacity (#400F67FE) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#400F67FE" />
        </shape>
    </item>
    <!-- Inner Card: #4E75F7, radius 12dp -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#4E75F7" />
        </shape>
    </item>
</layer-list>
