<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardRecordRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_profile_input_card"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivArrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Date -->
            <TextView
                android:id="@+id/tvRecordDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:textColor="#3772FF"
                android:textSize="12sp"
                tools:text="Sep 28" />

            <!-- Name / Title -->
            <TextView
                android:id="@+id/tvRecordName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_text"
                android:textSize="16sp"
                tools:text="Cetirizine" />

            <!-- Subtitle / Details -->
            <TextView
                android:id="@+id/tvRecordSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/urbanist_medium"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/color_subtext"
                android:textSize="13sp"
                tools:text="10 mg · 1 tablet · Once daily" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="8dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrowright"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#8F9CAE" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
