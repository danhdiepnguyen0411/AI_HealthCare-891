<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_language_card_unselected"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <!-- Circular Flag: 40dp x 40dp -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivFlag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_flag_en" />

    <!-- Language Title & Native Subtitle -->
    <LinearLayout
        android:id="@+id/textContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/ivFlag"
        app:layout_constraintEnd_toStartOf="@+id/indicatorContainer"
        app:layout_constraintStart_toEndOf="@+id/ivFlag"
        app:layout_constraintTop_toTopOf="@+id/ivFlag">

        <TextView
            android:id="@+id/tvLanguageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="English (UK)" />

        <TextView
            android:id="@+id/tvNativeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="English" />
    </LinearLayout>

    <!-- Selection Checkbox / Radio (sellect_lang / unsellect_lang) -->
    <FrameLayout
        android:id="@+id/indicatorContainer"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/ivFlag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivFlag">

        <ImageView
            android:id="@+id/ivRadio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/unsellect_lang" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
