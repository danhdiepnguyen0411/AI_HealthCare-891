<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutNotificationRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_custom_notification"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Main Header & Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/ivNotificationIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/notification_app_title"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_noti_app_logo" />

        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Header: Health Link • now -->
            <LinearLayout
                android:id="@+id/layoutNotificationHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotificationAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/notification_app_title"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNotificationDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="  •  "
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNotificationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/noti_time_now"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/urbanist"
                android:includeFontPadding="false"
                android:text="Time to exercise"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Message (supports multi-line expansion) -->
            <TextView
                android:id="@+id/tvNotificationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/urbanist"
                android:includeFontPadding="false"
                android:maxLines="6"
                android:text="Let's keep your body active!"
                android:textColor="#64748B"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Optional Action Buttons (e.g. Mark as done for reminders) -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnNotificationDone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_noti_action_btn"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/noti_reminder_action_done"
            android:textColor="@color/primary_color"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
