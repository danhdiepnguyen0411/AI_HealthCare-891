<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="5dp">

    <!-- Robot Avatar on bottom-left of the bubble -->
    <FrameLayout
        android:id="@+id/containerBotAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_chat_bot_avatar_circle"
        app:layout_constraintBottom_toBottomOf="@+id/containerBotBubble"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivBotAvatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/agent_chat" />
    </FrameLayout>

    <!-- Message Bubble Container -->
    <FrameLayout
        android:id="@+id/containerBotBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="44dp"
        android:background="@drawable/bg_chat_bot_bubble"
        android:elevation="0.5dp"
        android:minHeight="38dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/containerBotAvatar"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Regular Text Message -->
        <TextView
            android:id="@+id/tvBotMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_medium"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3.5dp"
            android:textColor="#242E49"
            android:textSize="14sp"
            tools:text="I'm sorry to hear that. Headaches can be caused by many factors. Have you been drinking enough water today?" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
