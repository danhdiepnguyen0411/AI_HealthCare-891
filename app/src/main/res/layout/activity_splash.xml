<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg">

    <!-- Center Brand: Logo + AI HEALTH / Personal Care -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="144dp"
        android:layout_height="124dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_rm_cropped"
        app:layout_constraintBottom_toTopOf="@+id/brandTextContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48"
        app:layout_constraintVertical_chainStyle="packed" />

    <LinearLayout
        android:id="@+id/brandTextContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:text="@string/splash_app_title_line1"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/urbanist"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/splash_app_title_line2"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Section: Loading (60%), ProgressBar, Ads Notice -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="65dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/splash_loading"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Loading (60%)" />

        <com.example.healthcareai.ui.widget.SplashProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <TextView
            android:id="@+id/tvAdsNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/urbanist_medium"
            android:includeFontPadding="false"
            android:text="@string/splash_ads_notice"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:fontFamily="@font/urbanist_medium" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
