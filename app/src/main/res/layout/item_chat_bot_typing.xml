<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="5dp">

    <!-- Robot Avatar on bottom-left of the bubble -->
    <FrameLayout
        android:id="@+id/containerBotAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_chat_bot_avatar_circle"
        app:layout_constraintBottom_toBottomOf="@+id/containerTypingBubble"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/agent_chat" />
    </FrameLayout>

    <!-- Typing Bubble: Exactly Figma Hug 62px x Hug 38px, 16px padding, 6px gap -->
    <LinearLayout
        android:id="@+id/containerTypingBubble"
        android:layout_width="62dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chat_bot_bubble"
        android:elevation="0.5dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/containerBotAvatar"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_chat_typing_dot" />

        <View
            android:id="@+id/dot2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chat_typing_dot" />

        <View
            android:id="@+id/dot3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chat_typing_dot" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
