<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootConfirmPhotoLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgr">

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Circular Back Button -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_back_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_chevron" />
        </FrameLayout>

        <!-- Title: Confirm Photo -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist"
            android:text="@string/title_confirm_photo"
            android:textColor="@color/color_text"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Photo Framing Area (Host container for dynamic ratio frame) -->
    <FrameLayout
        android:id="@+id/frameContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvAspectRatioLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <!-- The actual photo frame (card with 24dp rounded corners) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFrame"
            android:layout_width="250dp"
            android:layout_height="444dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/black"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardMaxElevation="8dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false">

            <!-- Interactive Pan & Zoom ImageView -->
            <com.example.healthcareai.ui.camera.InteractiveCropImageView
                android:id="@+id/cropImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 4 Corner Brackets Overlay (Inset 12dp inside the photo frame) -->
            <ImageView
                android:id="@+id/ivTopLeft"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/top_left" />

            <ImageView
                android:id="@+id/ivTopRight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/top_right" />

            <ImageView
                android:id="@+id/ivBottomLeft"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/bottom_left" />

            <ImageView
                android:id="@+id/ivBottomRight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/bottom_right" />
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Subheading: Aspect Ratio -->
    <TextView
        android:id="@+id/tvAspectRatioLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/urbanist"
        android:text="@string/label_aspect_ratio"
        android:textColor="@color/color_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/layoutRatios"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 5 Aspect Ratio Selection Cards -->
    <LinearLayout
        android:id="@+id/layoutRatios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btnUsePhoto">

        <!-- Ratio 1: 9:16 (Default Selected) -->
        <LinearLayout
            android:id="@+id/itemRatio916"
            android:layout_width="0dp"
            android:layout_height="73dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ratio_item_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivRatio916"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_9_16"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvRatio916"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/urbanist_semibold"
                app:fontFamily="@font/urbanist_semibold"
                android:text="@string/ratio_9_16"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ratio 2: 1:1 -->
        <LinearLayout
            android:id="@+id/itemRatio11"
            android:layout_width="0dp"
            android:layout_height="73dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ratio_item_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivRatio11"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_1_1"
                app:tint="@color/ratio_unselected_icon" />

            <TextView
                android:id="@+id/tvRatio11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/urbanist_semibold"
                app:fontFamily="@font/urbanist_semibold"
                android:text="@string/ratio_1_1"
                android:textColor="@color/ratio_unselected_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ratio 3: 2:3 -->
        <LinearLayout
            android:id="@+id/itemRatio23"
            android:layout_width="0dp"
            android:layout_height="73dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ratio_item_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivRatio23"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_2_3"
                app:tint="@color/ratio_unselected_icon" />

            <TextView
                android:id="@+id/tvRatio23"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/urbanist_semibold"
                app:fontFamily="@font/urbanist_semibold"
                android:text="@string/ratio_2_3"
                android:textColor="@color/ratio_unselected_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ratio 4: 3:4 -->
        <LinearLayout
            android:id="@+id/itemRatio34"
            android:layout_width="0dp"
            android:layout_height="73dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ratio_item_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivRatio34"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_3_4"
                app:tint="@color/ratio_unselected_icon" />

            <TextView
                android:id="@+id/tvRatio34"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/urbanist_semibold"
                app:fontFamily="@font/urbanist_semibold"
                android:text="@string/ratio_3_4"
                android:textColor="@color/ratio_unselected_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ratio 5: 16:9 -->
        <LinearLayout
            android:id="@+id/itemRatio169"
            android:layout_width="0dp"
            android:layout_height="73dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ratio_item_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivRatio169"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_16_9"
                app:tint="@color/ratio_unselected_icon" />

            <TextView
                android:id="@+id/tvRatio169"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/urbanist_semibold"
                app:fontFamily="@font/urbanist_semibold"
                android:text="@string/ratio_16_9"
                android:textColor="@color/ratio_unselected_text"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Primary Action: Use this photo -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnUsePhoto"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_btn_start_scan"
        android:fontFamily="@font/urbanist"
        android:paddingHorizontal="32dp"
        android:stateListAnimator="@null"
        android:text="@string/btn_use_photo"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btnRetakePhoto" />

    <!-- Secondary Action: Retake photo -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRetakePhoto"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_secondary"
        android:fontFamily="@font/urbanist"
        android:paddingHorizontal="32dp"
        android:stateListAnimator="@null"
        android:text="@string/btn_retake_photo"
        android:textAllCaps="false"
        android:textColor="@color/primary_color"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
