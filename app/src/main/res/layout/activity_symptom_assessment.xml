<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAssessmentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top Bar: Back Button, Progress Fraction (1/10, 2/10...), and Line Progress Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Circular Back Button -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_back_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_back_chevron" />
        </FrameLayout>

        <!-- Question Counter Fraction (e.g. 1/10, 2/10) -->
        <TextView
            android:id="@+id/tvProgressCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/urbanist_semibold"
            app:fontFamily="@font/urbanist_semibold"
            android:includeFontPadding="false"
            android:text="1/10"
            android:textColor="@color/color_subtext"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Line Progress Bar: Track #D0D5DB, Progress #242E49, Height 8dp, Radius 2dp -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/bg_assessment_progress"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvProgressCount"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Content Container for Questions -->
    <FrameLayout
        android:id="@+id/questionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomButtons"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <!-- ============================================================= -->
        <!-- QUESTION 1: WHAT IS YOUR AGE?                                 -->
        <!-- ============================================================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutAgeQuestion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Question 1 Title: Figma 24sp Bold #242E49 -->
            <TextView
                android:id="@+id/tvAgeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/urbanist_bold"
                app:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="36sp"
                android:text="@string/assessment_age_title"
                android:textColor="@color/color_text"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Center Age Picker Wheel Container -->
            <LinearLayout
                android:id="@+id/wheelContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAgeTitle">

                <TextView
                    android:id="@+id/tvAgeMinus2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:text="17"
                    android:textColor="@color/disable_color"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvAgeMinus1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:text="18"
                    android:textColor="@color/color_subtext"
                    android:textSize="38sp" />

                <!-- Selected Age Card: 150x150 + 4dp ring, #4E75F7 -->
                <FrameLayout
                    android:id="@+id/frameSelectedAge"
                    android:layout_width="158dp"
                    android:layout_height="158dp"
                    android:background="@drawable/bg_age_card_selected">

                    <TextView
                        android:id="@+id/tvSelectedAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/urbanist_bold"
                        app:fontFamily="@font/urbanist_bold"
                        android:includeFontPadding="false"
                        android:text="19"
                        android:textColor="@color/white"
                        android:textSize="72sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvAgePlus1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:text="20"
                    android:textColor="@color/color_subtext"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/tvAgePlus2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:text="21"
                    android:textColor="@color/disable_color"
                    android:textSize="26sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============================================================= -->
        <!-- QUESTION 2: WHAT IS YOUR GENDER?                              -->
        <!-- ============================================================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutGenderQuestion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Question 2 Title: Figma 24sp Bold #242E49 -->
            <TextView
                android:id="@+id/tvGenderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/urbanist_bold"
                app:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="36sp"
                android:text="@string/assessment_gender_title"
                android:textColor="@color/color_text"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Question 2 Subtitle: Figma 16sp Regular #56627A -->
            <TextView
                android:id="@+id/tvGenderSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/urbanist_regular"
                app:fontFamily="@font/urbanist_regular"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="24sp"
                android:text="@string/assessment_gender_subtitle"
                android:textColor="@color/color_subtext"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvGenderTitle" />

            <!-- Center Gender Cards Container: Male (top) and Female (bottom) -->
            <LinearLayout
                android:id="@+id/genderCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvGenderSubtitle">

                <!-- Male Avatar Card: Enlaraged 180x180, radius 20dp, #6A8BFB -->
                <FrameLayout
                    android:id="@+id/frameCardMale"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:background="@drawable/bg_card_male_selected"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivMale"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@string/gender_male"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/male" />
                </FrameLayout>

                <!-- Female Avatar Card: Enlaraged 180x180, radius 20dp, #FE808B -->
                <FrameLayout
                    android:id="@+id/frameCardFemale"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card_female_unselected"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivFemale"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@string/gender_female"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/female" />
                </FrameLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============================================================= -->
        <!-- QUESTION 3: WHAT ARE YOUR SYMPTOMS?                           -->
        <!-- ============================================================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutSymptomsQuestion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Question 3 Title: Figma 24sp Bold #242E49 -->
            <TextView
                android:id="@+id/tvSymptomsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/urbanist_bold"
                app:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="36sp"
                android:text="@string/assessment_symptoms_title"
                android:textColor="@color/color_text"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Search Input Bar: White background, 16dp rounded, 50 chars max -->
            <LinearLayout
                android:id="@+id/layoutSearchBar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                app:layout_constraintTop_toBottomOf="@+id/tvSymptomsTitle">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etSearchSymptoms"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    app:fontFamily="@font/urbanist_medium"
                    android:hint="@string/search_symptoms_hint"
                    android:imeOptions="actionDone"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLength="50"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/color_text"
                    android:textColorHint="#949494"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivClearSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 5 Options Viewport Container with Continuous Scroll Track & Thumb Line -->
            <LinearLayout
                android:id="@+id/layoutOptionsWithScrollbar"
                android:layout_width="match_parent"
                android:layout_height="292dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/layoutSearchBar">

                <!-- Symptoms RecyclerView (5 items viewport) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSymptoms"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <!-- Visible Scroll Track Line (the line next to options circled in pink) -->
                <FrameLayout
                    android:id="@+id/layoutScrollTrack"
                    android:layout_width="3.5dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_scrollbar_track">

                    <!-- Scroll Slider Thumb Indicator -->
                    <View
                        android:id="@+id/viewScrollThumb"
                        android:layout_width="3.5dp"
                        android:layout_height="48dp"
                        android:background="@drawable/scrollbar_thumb" />
                </FrameLayout>

            </LinearLayout>

            <!-- Selected Chips Area with Multi-line Wrapping (FlowLayout) -->
            <LinearLayout
                android:id="@+id/layoutSelectedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:gravity="top"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/layoutOptionsWithScrollbar">

                <TextView
                    android:id="@+id/tvSelectedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/urbanist_medium"
                    app:fontFamily="@font/urbanist_medium"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="Selected:"
                    android:textColor="#56627A"
                    android:textSize="13sp" />

                <com.example.healthcareai.ui.widget.FlowLayout
                    android:id="@+id/layoutSelectedChips"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- Empty Search State -->
            <TextView
                android:id="@+id/tvEmptySearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/urbanist_medium"
                android:textColor="@color/color_subtext"
                android:textSize="15sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutSearchBar" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============================================================= -->
        <!-- QUESTION 4: DO YOU HAVE ANY OF THE FOLLOWING SYMPTOMS?        -->
        <!-- ============================================================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutRelatedSymptomsQuestion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Question 4 Title: Figma 24sp Bold #242E49 -->
            <TextView
                android:id="@+id/tvRelatedTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/urbanist_bold"
                app:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="36sp"
                android:text="@string/assessment_related_symptoms_title"
                android:textColor="@color/color_text"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Question 4 Subtitle: Figma 16sp Regular #56627A -->
            <TextView
                android:id="@+id/tvRelatedSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/urbanist_regular"
                app:fontFamily="@font/urbanist_regular"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="24sp"
                android:text="@string/assessment_related_symptoms_subtitle"
                android:textColor="@color/color_subtext"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvRelatedTitle" />

            <!-- Related Symptoms RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRelatedSymptoms"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvRelatedSubtitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============================================================= -->
        <!-- QUESTION 5: INSECT BITE                                       -->
        <!-- ============================================================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutInsectBiteQuestion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Question 5 Title: Figma 24sp Bold #242E49 -->
            <TextView
                android:id="@+id/tvInsectBiteTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/urbanist_bold"
                app:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="36sp"
                android:text="@string/assessment_insect_bite_title"
                android:textColor="@color/color_text"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Options Container: Yes, No, Don't know -->
            <LinearLayout
                android:id="@+id/layoutInsectOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="36dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/tvInsectBiteTitle">

                <!-- Option 1: Yes -->
                <FrameLayout
                    android:id="@+id/cardInsectYes"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_symptom_card_unselected"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvInsectYes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/urbanist_medium"
                            app:fontFamily="@font/urbanist_medium"
                            android:includeFontPadding="false"
                            android:text="@string/option_yes"
                            android:textColor="@color/color_text"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/ivInsectYesCheck"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/bg_checkbox_unchecked" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Option 2: No (selected by default in screenshot) -->
                <FrameLayout
                    android:id="@+id/cardInsectNo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_symptom_card_selected"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvInsectNo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/urbanist_medium"
                            app:fontFamily="@font/urbanist_medium"
                            android:includeFontPadding="false"
                            android:text="@string/option_no"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/ivInsectNoCheck"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/bg_checkbox_selected_white" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Option 3: Don't know -->
                <FrameLayout
                    android:id="@+id/cardInsectDontKnow"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_symptom_card_unselected"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvInsectDontKnow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/urbanist_medium"
                            app:fontFamily="@font/urbanist_medium"
                            android:includeFontPadding="false"
                            android:text="@string/option_dont_know"
                            android:textColor="@color/color_text"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/ivInsectDontKnowCheck"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/bg_checkbox_unchecked" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <!-- Bottom Buttons: Back & Continue (Height 52px, Radius 112px) -->
    <LinearLayout
        android:id="@+id/layoutBottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:animateLayoutChanges="true"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Secondary Back Button (Light blue background, blue text) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBottomBack"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/urbanist_bold"
            app:fontFamily="@font/urbanist_bold"
            android:includeFontPadding="false"
            android:paddingHorizontal="20dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_back"
            android:textAllCaps="false"
            android:textColor="@color/primary_color"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Primary Continue Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_btn_blue"
            android:fontFamily="@font/urbanist_bold"
            app:fontFamily="@font/urbanist_bold"
            android:includeFontPadding="false"
            android:paddingHorizontal="24dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
