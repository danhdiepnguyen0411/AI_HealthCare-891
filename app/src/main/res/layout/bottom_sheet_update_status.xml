<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootUpdateStatus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Top Bar: Title & Close Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/urbanist_bold"
            android:includeFontPadding="false"
            android:text="@string/title_update_status"
            android:textColor="@color/color_text"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_circle_close_button"
            android:clickable="true"
            android:contentDescription="@string/btn_cancel"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_close_gray" />
    </FrameLayout>

    <!-- 1. Ongoing -->
    <FrameLayout
        android:id="@+id/cardStatusOngoing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_category_card_selected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="36dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitleOngoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:text="@string/status_ongoing_title"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSubOngoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/urbanist_medium"
                android:includeFontPadding="false"
                android:text="@string/status_ongoing_sub"
                android:textColor="#E0EAFF"
                android:textSize="13.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCheckOngoing"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_selected_white" />
    </FrameLayout>

    <!-- 2. Resolved -->
    <FrameLayout
        android:id="@+id/cardStatusResolved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="36dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitleResolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:text="@string/status_resolved_title"
                android:textColor="@color/color_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSubResolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/urbanist_medium"
                android:includeFontPadding="false"
                android:text="@string/status_resolved_sub"
                android:textColor="@color/color_subtext"
                android:textSize="13.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCheckResolved"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 3. Unsure -->
    <FrameLayout
        android:id="@+id/cardStatusUnsure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="36dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitleUnsure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:text="@string/status_unsure_title"
                android:textColor="@color/color_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSubUnsure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/urbanist_medium"
                android:includeFontPadding="false"
                android:text="@string/status_unsure_sub"
                android:textColor="@color/color_subtext"
                android:textSize="13.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCheckUnsure"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- Save status Button -->
    <FrameLayout
        android:id="@+id/btnSaveStatus"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_pill_btn_blue"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/btn_save_status"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
