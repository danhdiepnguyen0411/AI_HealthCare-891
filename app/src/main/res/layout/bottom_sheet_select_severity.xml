<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSelectSeverity"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/urbanist_bold"
        android:includeFontPadding="false"
        android:text="@string/title_select_severity"
        android:textColor="#172044"
        android:textSize="22sp" />

    <!-- 1. Mild -->
    <FrameLayout
        android:id="@+id/cardSeverityMild"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleSeverityMild"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/severity_mild"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckSeverityMild"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 2. Moderate -->
    <FrameLayout
        android:id="@+id/cardSeverityModerate"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleSeverityModerate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/severity_moderate"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckSeverityModerate"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 3. Severe -->
    <FrameLayout
        android:id="@+id/cardSeveritySevere"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleSeveritySevere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/severity_severe"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckSeveritySevere"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 4. Not sure -->
    <FrameLayout
        android:id="@+id/cardSeverityNotSure"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleSeverityNotSure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/severity_not_sure"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckSeverityNotSure"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- Continue Button -->
    <FrameLayout
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_btn_blue"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/btn_continue"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
