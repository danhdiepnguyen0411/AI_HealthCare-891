<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAddAllergy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgr"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_back_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/arrow_back" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_bold"
            android:includeFontPadding="false"
            android:text="Add allergy"
            android:textColor="@color/color_text"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- 1. Allergen name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Allergen name"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etAllergenName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Peniciline"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

            <!-- 2. Type Chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Type"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Chip Medication -->
                <TextView
                    android:id="@+id/chipTypeMedication"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_health_pill_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="Medication"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <!-- Chip Food -->
                <TextView
                    android:id="@+id/chipTypeFood"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_health_pill_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="Food"
                    android:textColor="#3772FF"
                    android:textSize="14sp" />

                <!-- Chip Other -->
                <TextView
                    android:id="@+id/chipTypeOther"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_health_pill_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="Other"
                    android:textColor="#3772FF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 4. Reaction & Severity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Reaction -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/urbanist_semibold"
                        android:includeFontPadding="false"
                        android:text="Reaction"
                        android:textColor="@color/color_subtext"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_profile_input_card">

                        <EditText
                            android:id="@+id/etReaction"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:fontFamily="@font/urbanist_medium"
                            android:hint="Hives"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/color_text"
                            android:textColorHint="#BEC5D2"
                            android:textSize="15.5sp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Severity -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/urbanist_semibold"
                        android:includeFontPadding="false"
                        android:text="Severity"
                        android:textColor="@color/color_subtext"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/cardSeverity"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_profile_input_card"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvSeverity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="32dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="Not sure"
                            android:textColor="@color/color_text"
                            android:textSize="15.5sp" />

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrowright" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 5. First noticed -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="First noticed"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardFirstNoticed"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvFirstNoticed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="42dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Date not provided"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar" />
            </FrameLayout>

            <!-- 6. Notes (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Notes (optional)"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="top|start"
                    android:hint="Reaction reported during a previous course."
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="54dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/backgr"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/btnSaveAllergy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill_btn_blue"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/urbanist"
                android:includeFontPadding="false"
                android:text="Save allergy"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
