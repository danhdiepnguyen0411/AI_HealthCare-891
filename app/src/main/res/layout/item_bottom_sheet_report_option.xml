<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReportOption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_bottom_sheet_item_unselected"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOptionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/urbanist"
                android:maxLines="1"
                android:textColor="#172044"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Harmful content" />

            <ImageView
                android:id="@+id/ivCheckbox"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/bg_checkbox_unchecked" />

        </LinearLayout>

        <!-- Feedback Box (visible only when Others is selected) -->
        <EditText
            android:id="@+id/etCustomFeedback"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_uninstall_feedback_input"
            android:fontFamily="@font/urbanist"
            android:gravity="top|start"
            android:hint="@string/uninstall_reason_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:includeFontPadding="false"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:scrollbars="vertical"
            android:textColor="#172044"
            android:textColorHint="#6B7F9E"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
