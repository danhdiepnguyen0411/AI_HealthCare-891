<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAddCondition"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgr"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_back_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/arrow_back" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_bold"
            android:includeFontPadding="false"
            android:text="Add condition"
            android:textColor="@color/color_text"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- 1. Condition name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Condition name"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etConditionName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Allergic rhinitis"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

            <!-- 2. Status Chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Status"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Chip Ongoing -->
                <TextView
                    android:id="@+id/chipStatusOngoing"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_health_pill_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="Ongoing"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <!-- Chip Resolved -->
                <TextView
                    android:id="@+id/chipStatusResolved"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_health_pill_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="Resolved"
                    android:textColor="#3772FF"
                    android:textSize="14sp" />

                <!-- Chip Unsure -->
                <TextView
                    android:id="@+id/chipStatusUnsure"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_health_pill_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="Unsure"
                    android:textColor="#3772FF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 3. Clinician -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Clinician"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etClinician"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Not provided"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

            <!-- 4. Clinic -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Clinic"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etClinic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Not provided"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

            <!-- 5. Diagnosis date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Diagnosis date"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardDiagnosisDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvDiagnosisDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="42dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Oct 8, 2026"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar" />
            </FrameLayout>

            <!-- 6. Notes (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="Notes (optional)"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="top|start"
                    android:hint="Recorded after my allergy consultation."
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="54dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/backgr"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/btnSaveCondition"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill_btn_blue"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/urbanist"
                android:includeFontPadding="false"
                android:text="Save condition"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
