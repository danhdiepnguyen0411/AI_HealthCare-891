<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_leave_without_saving"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <!-- Danger Triangle Icon (60x60dp) -->
    <ImageView
        android:id="@+id/ivDangerTriangle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_danger_triangle" />

    <!-- Discard Prompt Title -->
    <TextView
        android:id="@+id/tvLeaveTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/urbanist"
        android:gravity="center"
        android:textAlignment="center"
        android:text="@string/dialog_leave_without_saving_title"
        android:textColor="@color/color_text"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Leave Without Saving?" />

    <!-- Discard Prompt Message -->
    <TextView
        android:id="@+id/tvLeaveMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/urbanist"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/dialog_leave_without_saving_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Your analysis is not saved. If you leave now,\nyou won't be able to view these results again." />

    <!-- Primary Button: Stay on this page -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStayOnPage"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_stay_on_page"
        android:elevation="0dp"
        android:fontFamily="@font/urbanist"
        android:stateListAnimator="@null"
        android:text="@string/btn_stay_on_page"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Stay on this page" />

    <!-- Secondary Button: Exit without saving -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnExitWithoutSaving"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_exit_without_saving"
        android:elevation="0dp"
        android:fontFamily="@font/urbanist"
        android:stateListAnimator="@null"
        android:text="@string/btn_exit_without_saving"
        android:textAllCaps="false"
        android:textColor="#FF4347"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Exit without saving" />

</LinearLayout>

