<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSelectCustomDays"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/urbanist_bold"
        android:includeFontPadding="false"
        android:text="@string/repeat_custom"
        android:textColor="#172044"
        android:textSize="22sp" />

    <!-- 1. Monday -->
    <FrameLayout
        android:id="@+id/cardDayMonday"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvDayMonday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/day_monday"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckMonday"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 2. Tuesday -->
    <FrameLayout
        android:id="@+id/cardDayTuesday"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvDayTuesday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/day_tuesday"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckTuesday"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 3. Wednesday -->
    <FrameLayout
        android:id="@+id/cardDayWednesday"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvDayWednesday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/day_wednesday"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckWednesday"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 4. Thursday -->
    <FrameLayout
        android:id="@+id/cardDayThursday"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvDayThursday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/day_thursday"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckThursday"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 5. Friday -->
    <FrameLayout
        android:id="@+id/cardDayFriday"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvDayFriday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/day_friday"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckFriday"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 6. Saturday -->
    <FrameLayout
        android:id="@+id/cardDaySaturday"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvDaySaturday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/day_saturday"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckSaturday"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 7. Sunday -->
    <FrameLayout
        android:id="@+id/cardDaySunday"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvDaySunday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/day_sunday"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckSunday"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- Save Button -->
    <FrameLayout
        android:id="@+id/btnSaveCustomDays"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_pill_btn_blue"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/btn_save"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>

