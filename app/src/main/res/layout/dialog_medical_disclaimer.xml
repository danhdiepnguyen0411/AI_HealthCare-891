<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Shield Warning Icon (60x60dp) -->
        <ImageView
            android:id="@+id/ivShieldIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shield_warning" />

        <!-- Title: Medical Disclaimer -->
        <TextView
            android:id="@+id/tvDisclaimerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/urbanist"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:text="@string/medical_disclaimer_dialog_title"
            android:textColor="#242E49"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Description: General health info notice -->
        <TextView
            android:id="@+id/tvDisclaimerDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/urbanist"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:text="@string/dialog_medical_disclaimer_desc"
            android:textColor="#56627A"
            android:textSize="12.5sp" />

        <!-- Primary Button: I Understand (44dp height, #0F67FE, radius 100dp) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUnderstand"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_btn_blue"
            android:fontFamily="@font/urbanist"
            android:stateListAnimator="@null"
            android:text="@string/dialog_medical_disclaimer_btn"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

