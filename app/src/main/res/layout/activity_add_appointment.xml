<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAddAppointment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgr"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_back_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/arrow_back" />
        </FrameLayout>

        <com.example.healthcareai.ui.widget.MarqueeTextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="52dp"
            android:fontFamily="@font/urbanist_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/title_add_appointment"
            android:textColor="@color/color_text"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- 1. Appointment title / reason -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_appointment_title"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etAppointmentName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Cardiology consultation"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

            <!-- 2. Status Chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_status"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- Chip Upcoming -->
                <TextView
                    android:id="@+id/chipStatusUpcoming"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_health_pill_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="@string/status_upcoming_title"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <!-- Chip Completed -->
                <TextView
                    android:id="@+id/chipStatusCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_health_pill_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="@string/status_completed_title"
                    android:textColor="#3772FF"
                    android:textSize="14sp" />

                <!-- Chip Cancelled -->
                <TextView
                    android:id="@+id/chipStatusCancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_health_pill_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/urbanist_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:text="@string/status_cancelled_title"
                    android:textColor="#3772FF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 3. Doctor / Clinician -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_clinician"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etClinician"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Dr. Sarah Jenkins"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

            <!-- 4. Clinic / Hospital -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_clinic"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etClinic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="City General Hospital"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

            <!-- 5. Appointment Date & Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_appointment_date"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardAppointmentDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvAppointmentDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="42dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="Select date &amp; time"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar" />
            </FrameLayout>

            <!-- 6. Notes (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_reminder_notes"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="top|start"
                    android:hint="Bring previous medical records and test results."
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="100"
                    android:minHeight="54dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/backgr"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/btnSaveAppointment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill_btn_blue"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/urbanist"
                android:includeFontPadding="false"
                android:text="@string/btn_save_appointment"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

