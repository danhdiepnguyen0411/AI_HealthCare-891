<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProfileItem"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_bottom_sheet_item_unselected"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Avatar Container (48dp circle) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_person" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Name & Relationship Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist"
                android:maxLines="1"
                android:textColor="#172044"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Alex Morgan" />

            <TextView
                android:id="@+id/tvProfileRelationship"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/urbanist"
                android:maxLines="1"
                android:textColor="#7A808C"
                android:textSize="13sp"
                tools:text="You" />
        </LinearLayout>

        <!-- Checkbox -->
        <ImageView
            android:id="@+id/ivCheckbox"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />

    </LinearLayout>

</FrameLayout>
