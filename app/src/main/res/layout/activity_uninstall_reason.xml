<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    tools:context=".ui.uninstall.UninstallReasonActivity">

    <!-- Top Back Button (Circular) -->
    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_circle_back_button"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/btn_skip"
            android:src="@drawable/ic_back_chevron" />
    </FrameLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/llBottomButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist_bold"
                app:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="28sp"
                android:text="@string/uninstall_reason_title"
                android:textColor="@color/color_text"
                android:textSize="22sp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp"
                android:fontFamily="@font/urbanist_medium"
                app:fontFamily="@font/urbanist_medium"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:lineHeight="20sp"
                android:text="@string/uninstall_reason_subtitle"
                android:textColor="@color/color_subtext"
                android:textSize="14sp" />

            <!-- Option 1: Difficult to use -->
            <LinearLayout
                android:id="@+id/cardOption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_uninstall_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvOption1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/uninstall_reason_1"
                    android:textColor="@color/color_text"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivCheck1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/unsellect_lang" />
            </LinearLayout>

            <!-- Option 2: Too many ads -->
            <LinearLayout
                android:id="@+id/cardOption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_uninstall_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvOption2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/uninstall_reason_2"
                    android:textColor="@color/color_text"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivCheck2"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/unsellect_lang" />
            </LinearLayout>

            <!-- Option 3: Design quality not good enough -->
            <LinearLayout
                android:id="@+id/cardOption3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_uninstall_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvOption3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/uninstall_reason_3"
                    android:textColor="@color/color_text"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivCheck3"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/unsellect_lang" />
            </LinearLayout>

            <!-- Option 4: Other (expands with feedback input) -->
            <LinearLayout
                android:id="@+id/cardOption4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_uninstall_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOption4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/urbanist_bold"
                        app:fontFamily="@font/urbanist_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0"
                        android:text="@string/uninstall_reason_4"
                        android:textColor="@color/color_text"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/ivCheck4"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/unsellect_lang" />
                </LinearLayout>

                <!-- Feedback Box (visible only when Other is selected) -->
                <EditText
                    android:id="@+id/etCustomFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_uninstall_feedback_input"
                    android:fontFamily="@font/urbanist_medium"
                    app:fontFamily="@font/urbanist_medium"
                    android:gravity="top|start"
                    android:hint="@string/uninstall_reason_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/color_text"
                    android:textColorHint="#6B7F9E"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Buttons -->
    <LinearLayout
        android:id="@+id/llBottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Button: Don't want to uninstall -->
        <FrameLayout
            android:id="@+id/btnDontUninstall"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_uninstall_btn_primary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/urbanist_bold"
                app:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:text="@string/uninstall_btn_dont_uninstall"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </FrameLayout>

        <!-- Button: Still want to uninstall -->
        <FrameLayout
            android:id="@+id/btnStillWantUninstall"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_uninstall_btn_secondary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvStillWantUninstall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/urbanist_bold"
                app:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:text="@string/uninstall_btn_still_uninstall"
                android:textColor="@color/primary_color"
                android:textSize="16sp" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
