<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:padding="20dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_skip"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/uninstall_reason_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBack" />

    <LinearLayout
        android:id="@+id/cardOption1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_uninstall_card_unselected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/uninstall_reason_1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivCheck1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_radio_unselected" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardOption2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_uninstall_card_unselected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cardOption1">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/uninstall_reason_2"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivCheck2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_radio_unselected" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardOption3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_uninstall_card_unselected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cardOption2">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/uninstall_reason_3"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivCheck3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_radio_unselected" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardOption4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_uninstall_card_unselected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cardOption3">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/uninstall_reason_4"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivCheck4"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_radio_unselected" />
    </LinearLayout>

    <EditText
        android:id="@+id/etCustomFeedback"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_uninstall_card_unselected"
        android:gravity="top|start"
        android:hint="@string/uninstall_reason_hint"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/cardOption4" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/uninstall_btn_cancel"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirmUninstall" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmUninstall"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.4"
        android:background="@drawable/bg_uninstall_card_unselected"
        android:enabled="false"
        android:text="@string/uninstall_btn_confirm"
        android:textAllCaps="false"
        android:textColor="@color/danger"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
