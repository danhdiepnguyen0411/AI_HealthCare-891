<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Guideline dividing top illustration (58%) and bottom card (42%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/cardGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.58" />

    <!-- Top 3D Illustration: Edge-to-edge full bleed with NO padding -->
    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/cardGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/intro1" />

    <!-- Bottom White Content Sheet with Arch Top Curve -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardGuideline">

        <!-- Arched Top Curve Overlay placed at top of layoutCard -->
        <ImageView
            android:id="@+id/ivCurve"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_intro_curve"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- White solid body covering everything below the curve -->
        <View
            android:id="@+id/viewWhiteBody"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivCurve" />

        <!-- Title (Figma: Urbanist Bold 32px, Line height 120% / 38sp, #242E49) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="25dp"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/urbanist"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:lineHeight="38sp"
            android:textColor="@color/intro_title"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivCurve"
            tools:text="Understand your\nhealth better" />

        <!-- Subtitle / Description (Figma: Urbanist Medium 16px, Line height 130% / 21sp, #56627A) -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="25dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/urbanist_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:lineHeight="21sp"
            android:textColor="@color/intro_subtitle"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            tools:text="Explore concerns with photo analysis, symptom questions and your AI assistant." />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
