<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootReminder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgr"
    tools:context=".ui.reminder.ReminderActivity">

    <!-- Top Bar: Back Circular Button, Title "Reminder", Right Add Circular Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_back_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/arrow_back" />
        </FrameLayout>

        <com.example.healthcareai.ui.widget.MarqueeTextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="52dp"
            android:fontFamily="@font/urbanist_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:lineHeight="27sp"
            android:singleLine="true"
            android:text="@string/title_reminder"
            android:textColor="@color/color_text"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/btnAddReminder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_primary_button"
            android:clickable="true"
            android:visibility="gone"
            tools:visibility="visible"
            android:elevation="2dp"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_plus_small_white" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Calendar Month Header & Week Days Strip -->
    <LinearLayout
        android:id="@+id/layoutCalendarSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <!-- Month & Calendar Icon Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCalendarMonthYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:textColor="@color/color_text"
                android:textSize="18sp"
                tools:text="April 2026" />

            <ImageView
                android:id="@+id/ivCalendarAction"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar" />
        </LinearLayout>

        <!-- Horizontal Scrollable Week Days Strip (Scroll to see past and upcoming days) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendarDays"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Custom Full Month Calendar Dropdown (Expands when clicking ivCalendarAction) -->
        <LinearLayout
            android:id="@+id/layoutFullMonthCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_custom_month_calendar"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Month Navigation Header with 2 Arrow Icons -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="36dp">

                <FrameLayout
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="9dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/arrow_reminder_left" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFullMonthYearTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_text"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="April 2026" />

                <FrameLayout
                    android:id="@+id/btnNextMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="9dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/arrow_reminder_right" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Weekday Labels (7 Columns: Mon -> Sun) -->
            <LinearLayout
                android:id="@+id/layoutWeekdayLabels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="7">

                <TextView
                    android:id="@+id/tvWeekday0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_subtext"
                    android:textSize="12sp"
                    tools:text="T2" />

                <TextView
                    android:id="@+id/tvWeekday1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_subtext"
                    android:textSize="12sp"
                    tools:text="T3" />

                <TextView
                    android:id="@+id/tvWeekday2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_subtext"
                    android:textSize="12sp"
                    tools:text="T4" />

                <TextView
                    android:id="@+id/tvWeekday3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_subtext"
                    android:textSize="12sp"
                    tools:text="T5" />

                <TextView
                    android:id="@+id/tvWeekday4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_subtext"
                    android:textSize="12sp"
                    tools:text="T6" />

                <TextView
                    android:id="@+id/tvWeekday5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_subtext"
                    android:textSize="12sp"
                    tools:text="T7" />

                <TextView
                    android:id="@+id/tvWeekday6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_subtext"
                    android:textSize="12sp"
                    tools:text="CN" />
            </LinearLayout>

            <!-- 7-Column Days Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMonthDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

    </LinearLayout>

    <!-- Reminders List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReminders"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutCalendarSection"
        tools:listitem="@layout/item_reminder_card" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutCalendarSection"
        tools:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@null"
            android:src="@drawable/no_reminder_yet" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/urbanist_bold"
            android:includeFontPadding="false"
            android:text="@string/home_no_reminder_title"
            android:textColor="@color/color_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/urbanist_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/home_no_reminder_desc"
            android:textColor="@color/color_subtext"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEmptyAddReminder"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_home_pill_btn"
            android:fontFamily="@font/urbanist_bold"
            android:paddingHorizontal="24dp"
            android:stateListAnimator="@null"
            android:text="@string/home_btn_add_reminder"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
