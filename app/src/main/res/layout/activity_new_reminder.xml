<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootNewReminder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgr"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.reminder.NewReminderActivity">

    <!-- Top Bar: Centered Title (22sp Bold #242E49) and Circle Back Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_back_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/arrow_back" />
        </FrameLayout>

        <com.example.healthcareai.ui.widget.MarqueeTextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="52dp"
            android:fontFamily="@font/urbanist_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/title_new_reminder"
            android:textColor="@color/color_text"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Form Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- 1. Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_reminder_category"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardCategory"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="36dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="@string/hint_select_category"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrowright" />
            </FrameLayout>

            <!-- 2. Choose Item (Medication, Vaccination, Appointments) -->
            <LinearLayout
                android:id="@+id/layoutChooseItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvLabelChooseItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/urbanist_semibold"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_subtext"
                    android:textSize="13sp"
                    tools:text="Choose medication" />

                <FrameLayout
                    android:id="@+id/cardChooseItem"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_profile_input_card"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvChooseItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="36dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/urbanist_medium"
                        android:hint="Choose medication"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/color_text"
                        android:textColorHint="#BEC5D2"
                        android:textSize="15.5sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrowright" />
                </FrameLayout>
            </LinearLayout>

            <!-- 2b. Strength & Form (Shown for Medication) -->
            <LinearLayout
                android:id="@+id/layoutStrengthForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Strength Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/urbanist_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/label_reminder_strength"
                        android:textColor="@color/color_subtext"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_profile_input_card">

                        <EditText
                            android:id="@+id/etStrength"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:fontFamily="@font/urbanist_medium"
                            android:hint="@string/hint_reminder_strength"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="text"
                            android:maxLength="20"
                            android:maxLines="1"
                            android:paddingHorizontal="16dp"
                            android:text=""
                            android:textColor="@color/color_text"
                            android:textColorHint="#BEC5D2"
                            android:textSize="15.5sp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Form Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/urbanist_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/label_reminder_form"
                        android:textColor="@color/color_subtext"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:id="@+id/cardForm"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_profile_input_card"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvForm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="32dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/urbanist_medium"
                            android:hint="@string/hint_reminder_form"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/color_text"
                            android:textColorHint="#BEC5D2"
                            android:textSize="15.5sp" />

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrowright" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Repeat -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_reminder_repeat"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardRepeat"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvRepeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="36dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/urbanist_medium"
                    android:hint="@string/hint_repeat_schedule"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrowright" />
            </FrameLayout>

            <!-- 4. Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_reminder_time"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/cardReminderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_profile_input_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:id="@+id/layoutWheelTimePicker"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Hours Wheel (00 - 23) -->
                    <com.example.healthcareai.ui.widget.WheelPickerView
                        android:id="@+id/wheelHours"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <!-- Center vertical separator line -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center_vertical"
                        android:background="#E5E7EB" />

                    <!-- Minutes Wheel (00 - 59) -->
                    <com.example.healthcareai.ui.widget.WheelPickerView
                        android:id="@+id/wheelMinutes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

            <!-- 5. Notes (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/urbanist_semibold"
                android:includeFontPadding="false"
                android:text="@string/label_reminder_notes"
                android:textColor="@color/color_subtext"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/cardReminderNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_profile_input_card">

                <EditText
                    android:id="@+id/etReminderNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/urbanist_medium"
                    android:gravity="top|start"
                    android:hint="@string/hint_add_notes"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="100"
                    android:minHeight="54dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:text=""
                    android:textColor="@color/color_text"
                    android:textColorHint="#BEC5D2"
                    android:textSize="15.5sp" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Actions: Save Reminder & Cancel -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/backgr"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Save Reminder Button -->
        <FrameLayout
            android:id="@+id/btnSaveReminder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill_btn_blue"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/urbanist"
                android:includeFontPadding="false"
                android:text="@string/btn_save_reminder"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Cancel Button -->
        <FrameLayout
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/urbanist"
                android:includeFontPadding="false"
                android:text="@string/btn_cancel"
                android:textColor="@color/primary_color"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
