<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSelectForm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/urbanist_bold"
        android:includeFontPadding="false"
        android:text="@string/title_select_form"
        android:textColor="#172044"
        android:textSize="22sp" />

    <!-- Scrollable Options List -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFormOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Tablet -->
            <FrameLayout
                android:id="@+id/cardFormTablet"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_category_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTitleFormTablet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/form_tablet"
                    android:textColor="@color/color_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCheckFormTablet"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_checkbox_unchecked" />
            </FrameLayout>

            <!-- 2. Capsule -->
            <FrameLayout
                android:id="@+id/cardFormCapsule"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_category_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTitleFormCapsule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/form_capsule"
                    android:textColor="@color/color_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCheckFormCapsule"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_checkbox_unchecked" />
            </FrameLayout>

            <!-- 3. Liquid -->
            <FrameLayout
                android:id="@+id/cardFormLiquid"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_category_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTitleFormLiquid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/form_liquid"
                    android:textColor="@color/color_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCheckFormLiquid"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_checkbox_unchecked" />
            </FrameLayout>

            <!-- 4. Drops -->
            <FrameLayout
                android:id="@+id/cardFormDrops"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_category_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTitleFormDrops"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/form_drops"
                    android:textColor="@color/color_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCheckFormDrops"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_checkbox_unchecked" />
            </FrameLayout>

            <!-- 5. Injection -->
            <FrameLayout
                android:id="@+id/cardFormInjection"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_category_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTitleFormInjection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/form_injection"
                    android:textColor="@color/color_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCheckFormInjection"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_checkbox_unchecked" />
            </FrameLayout>

            <!-- 6. Inhaler -->
            <FrameLayout
                android:id="@+id/cardFormInhaler"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_category_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTitleFormInhaler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/form_inhaler"
                    android:textColor="@color/color_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCheckFormInhaler"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_checkbox_unchecked" />
            </FrameLayout>

            <!-- 7. Other -->
            <FrameLayout
                android:id="@+id/cardFormOther"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_category_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTitleFormOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:fontFamily="@font/urbanist"
                    android:includeFontPadding="false"
                    android:text="@string/form_other"
                    android:textColor="@color/color_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCheckFormOther"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_checkbox_unchecked" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Continue Button -->
    <FrameLayout
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_btn_blue"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/btn_continue"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
