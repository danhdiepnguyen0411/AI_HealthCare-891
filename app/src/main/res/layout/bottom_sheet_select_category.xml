<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSelectCategory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/urbanist_bold"
        android:includeFontPadding="false"
        android:text="@string/title_select_category"
        android:textColor="@color/color_text"
        android:textSize="22sp" />

    <!-- Grid: 4 rows x 2 cols -->
    <!-- Row 1: Temperature & Heart rate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Temperature -->
        <LinearLayout
            android:id="@+id/cardCategoryTemperature"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_grid_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/ivIconTemperature"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_temperature"
                app:tint="#4E75F7" />

            <TextView
                android:id="@+id/tvTitleTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Temperature"
                android:textColor="@color/color_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Heart rate -->
        <LinearLayout
            android:id="@+id/cardCategoryHeartRate"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_grid_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/ivIconHeartRate"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart_rate"
                app:tint="#4E75F7" />

            <TextView
                android:id="@+id/tvTitleHeartRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Heart rate"
                android:textColor="@color/color_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Medication & Drink Water -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Medication -->
        <LinearLayout
            android:id="@+id/cardCategoryMedication"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_grid_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/ivIconMedication"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_medications"
                app:tint="#4E75F7" />

            <TextView
                android:id="@+id/tvTitleMedication"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Medication"
                android:textColor="@color/color_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Drink Water -->
        <LinearLayout
            android:id="@+id/cardCategoryDrinkWater"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_grid_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/ivIconDrinkWater"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_drink_water"
                app:tint="#4E75F7" />

            <TextView
                android:id="@+id/tvTitleDrinkWater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Drink Water"
                android:textColor="@color/color_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Exercise & Sleep -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Exercise -->
        <LinearLayout
            android:id="@+id/cardCategoryExercise"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_grid_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/ivIconExercise"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_do_exercise"
                app:tint="#4E75F7" />

            <TextView
                android:id="@+id/tvTitleExercise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Exercise"
                android:textColor="@color/color_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Sleep -->
        <LinearLayout
            android:id="@+id/cardCategorySleep"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_grid_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/ivIconSleep"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sleep"
                app:tint="#4E75F7" />

            <TextView
                android:id="@+id/tvTitleSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Sleep"
                android:textColor="@color/color_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 4: Appointments & Vaccination -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Appointments -->
        <LinearLayout
            android:id="@+id/cardCategoryAppointments"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_grid_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/ivIconAppointments"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_appointments"
                app:tint="#4E75F7" />

            <TextView
                android:id="@+id/tvTitleAppointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Appointments"
                android:textColor="@color/color_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Vaccination -->
        <LinearLayout
            android:id="@+id/cardCategoryVaccination"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_grid_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/ivIconVaccination"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_vaccination"
                app:tint="#4E75F7" />

            <TextView
                android:id="@+id/tvTitleVaccination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/urbanist_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Vaccination"
                android:textColor="@color/color_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Continue Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn_submit_rating"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/urbanist"
        android:text="@string/btn_continue"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
