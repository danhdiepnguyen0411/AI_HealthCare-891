<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSelectRepeat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Title: 22sp Urbanist Bold #172044 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/urbanist_bold"
        android:includeFontPadding="false"
        android:text="@string/title_select_repeat"
        android:textColor="#172044"
        android:textSize="22sp" />

    <!-- 1. Every day -->
    <FrameLayout
        android:id="@+id/cardRepeatEveryDay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_selected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleRepeatEveryDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/repeat_every_day"
            android:textColor="@color/white"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckRepeatEveryDay"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_selected_white" />
    </FrameLayout>

    <!-- 2. Weekdays -->
    <FrameLayout
        android:id="@+id/cardRepeatWeekdays"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleRepeatWeekdays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/repeat_weekdays"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckRepeatWeekdays"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 3. Weekends -->
    <FrameLayout
        android:id="@+id/cardRepeatWeekends"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleRepeatWeekends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/repeat_weekends"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckRepeatWeekends"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 4. Weekly -->
    <FrameLayout
        android:id="@+id/cardRepeatWeekly"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleRepeatWeekly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/repeat_weekly"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckRepeatWeekly"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 5. Monthly -->
    <FrameLayout
        android:id="@+id/cardRepeatMonthly"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleRepeatMonthly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/repeat_monthly"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckRepeatMonthly"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- 6. Once -->
    <FrameLayout
        android:id="@+id/cardRepeatOnce"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_category_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvTitleRepeatOnce"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/repeat_once"
            android:textColor="@color/color_text"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCheckRepeatOnce"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_unchecked" />
    </FrameLayout>

    <!-- Continue Button -->
    <FrameLayout
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_btn_blue"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/urbanist"
            android:includeFontPadding="false"
            android:text="@string/btn_continue"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
