<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomSheetHowToMeasureRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingBottom="32dp">

    <!-- Top drag handle pill -->
    <View
        android:id="@+id/viewDragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Header: Title ("How to measure") & Close Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/viewDragHandle">

        <!-- Title: Urbanist 700 Bold, 22sp, line height 32sp, color #0F67FE -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_bold"
            app:fontFamily="@font/urbanist_bold"
            android:includeFontPadding="false"
            android:lineHeight="32sp"
            android:text="@string/how_to_measure_title"
            android:textColor="@color/primary_color"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Close "X" Button -->
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_close_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Phone and Hand Guide Illustration Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutIllustration"
        android:layout_width="112dp"
        android:layout_height="146dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <!-- Phone Back Image -->
        <ImageView
            android:id="@+id/ivGuidePhone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Hand with Index Finger placed firmly on camera lens -->
        <ImageView
            android:id="@+id/ivGuideHand"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hand"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3 Instruction Steps -->
    <LinearLayout
        android:id="@+id/layoutSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutIllustration">

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- Circle 1: 36x36dp, color #4E75F7 -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_step_number">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </FrameLayout>

            <!-- Text Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title: Urbanist 600 SemiBold, 16sp, line height 24sp, color #2A2A2A -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semibold"
                    app:fontFamily="@font/urbanist_semibold"
                    android:includeFontPadding="false"
                    android:lineHeight="24sp"
                    android:text="@string/how_to_measure_step1_title"
                    android:textColor="#2A2A2A"
                    android:textSize="16sp" />

                <!-- Subtitle: Urbanist 400 Regular, 12sp, line height 18sp, color #2A2A2A -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/urbanist_regular"
                    app:fontFamily="@font/urbanist_regular"
                    android:includeFontPadding="false"
                    android:lineHeight="18sp"
                    android:text="@string/how_to_measure_step1_desc"
                    android:textColor="#2A2A2A"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- Circle 2: 36x36dp, color #4E75F7 -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_step_number">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:text="2"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </FrameLayout>

            <!-- Text Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semibold"
                    app:fontFamily="@font/urbanist_semibold"
                    android:includeFontPadding="false"
                    android:lineHeight="24sp"
                    android:text="@string/how_to_measure_step2_title"
                    android:textColor="#2A2A2A"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/urbanist_regular"
                    app:fontFamily="@font/urbanist_regular"
                    android:includeFontPadding="false"
                    android:lineHeight="18sp"
                    android:text="@string/how_to_measure_step2_desc"
                    android:textColor="#2A2A2A"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- Circle 3: 36x36dp, color #4E75F7 -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_step_number">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/urbanist_bold"
                    app:fontFamily="@font/urbanist_bold"
                    android:includeFontPadding="false"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </FrameLayout>

            <!-- Text Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/urbanist_semibold"
                    app:fontFamily="@font/urbanist_semibold"
                    android:includeFontPadding="false"
                    android:lineHeight="24sp"
                    android:text="@string/how_to_measure_step3_title"
                    android:textColor="#2A2A2A"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/urbanist_regular"
                    app:fontFamily="@font/urbanist_regular"
                    android:includeFontPadding="false"
                    android:lineHeight="18sp"
                    android:text="@string/how_to_measure_step3_desc"
                    android:textColor="#2A2A2A"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
