<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReminderItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_choose_reminder_card"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Checkbox -->
        <ImageView
            android:id="@+id/ivCheckbox"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_checkbox_checked" />

        <!-- Icon Container (44dp x 44dp, light blue) -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_reminder_item_icon">

            <ImageView
                android:id="@+id/ivReminderIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_temperature" />
        </FrameLayout>

        <!-- Title & Subtitle / Times Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReminderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist"
                android:maxLines="1"
                android:textColor="#172044"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Check temperature" />

            <TextView
                android:id="@+id/tvReminderSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/urbanist"
                android:maxLines="1"
                android:textColor="#7A808C"
                android:textSize="13sp"
                tools:text="Daily · 8:00 AM, 8:00 PM" />
        </LinearLayout>

        <!-- Edit Button -->
        <TextView
            android:id="@+id/tvEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/urbanist"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="@string/btn_edit"
            android:textColor="#2F65F6"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>

