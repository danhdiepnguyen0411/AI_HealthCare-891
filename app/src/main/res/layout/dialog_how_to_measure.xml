<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="24dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardMaxElevation="12dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/urbanist_bold"
            app:fontFamily="@font/urbanist_bold"
            android:text="@string/heart_rate_guide_title"
            android:textColor="@color/color_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/urbanist_medium"
            app:fontFamily="@font/urbanist_medium"
            android:lineSpacingExtra="3dp"
            android:text="@string/heart_rate_guide_tip_1"
            android:textColor="@color/color_subtext"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/urbanist_medium"
            app:fontFamily="@font/urbanist_medium"
            android:lineSpacingExtra="3dp"
            android:text="@string/heart_rate_guide_tip_2"
            android:textColor="@color/color_subtext"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/urbanist_medium"
            app:fontFamily="@font/urbanist_medium"
            android:lineSpacingExtra="3dp"
            android:text="@string/heart_rate_guide_tip_3"
            android:textColor="@color/color_subtext"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGotIt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_btn_blue"
            android:fontFamily="@font/urbanist_semibold"
            app:fontFamily="@font/urbanist_semibold"
            android:stateListAnimator="@null"
            android:text="@string/heart_rate_guide_btn_got_it"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
